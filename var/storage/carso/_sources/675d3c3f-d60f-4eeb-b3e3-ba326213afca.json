{"document_id": "675d3c3f-d60f-4eeb-b3e3-ba326213afca", "meta": {"contenu_html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n</head>\n<body>\n\n<section class=\"cover\">\n  <h1>CARSO</h1>\n  <p class=\"cover-label\">Centre d'Affaires du Sud-Ouest</p>\n  <p class=\"cover-subtitle\">Groupement d'Intérêt Économique — Au service du développement entrepreneurial de la région Atsimo Andrefana, Madagascar</p>\n  <p class=\"cover-meta\">Présentation Institutionnelle — 2026</p>\n</section>\n\n<section class=\"slide\">\n  <h1>Sommaire</h1>\n  <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:30px;\">\n    <div style=\"background:#fff; border-radius:10px; padding:18px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n      <p style=\"font-size:14px; color:#0D7C6F; font-weight:700; margin-bottom:5px;\">① Qui sommes-nous ?</p>\n      <p style=\"font-size:11px; color:#555; line-height:1.4;\">Historique, mission et vision du Centre d'Affaires du Sud-Ouest.</p>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:18px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n      <p style=\"font-size:14px; color:#0D7C6F; font-weight:700; margin-bottom:5px;\">② Nos valeurs</p>\n      <p style=\"font-size:11px; color:#555; line-height:1.4;\">Innovation, Professionnalisme et Satisfaction Client.</p>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:18px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n      <p style=\"font-size:14px; color:#0D7C6F; font-weight:700; margin-bottom:5px;\">③ Secteurs &amp; Projets</p>\n      <p style=\"font-size:11px; color:#555; line-height:1.4;\">Agriculture, élevage, transformation, aquaculture et projets phares.</p>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:18px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n      <p style=\"font-size:14px; color:#0D7C6F; font-weight:700; margin-bottom:5px;\">④ Approche &amp; Partenaires</p>\n      <p style=\"font-size:11px; color:#555; line-height:1.4;\">Notre méthode d'accompagnement et nos partenaires clés.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"slide\">\n  <h1>Qui sommes-nous ?</h1>\n  <div style=\"display:flex; gap:25px; margin-top:20px;\">\n    <div style=\"flex:1;\">\n      <div style=\"background:#fff; border-radius:10px; padding:15px; margin-bottom:12px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n        <p style=\"font-size:12px; color:#0D7C6F; font-weight:700; margin-bottom:4px;\">📍 Identité</p>\n        <p style=\"font-size:10px; color:#333; line-height:1.4;\">Le <strong>CARSO</strong> est un <strong>GIE</strong> constitué pour accompagner le développement entrepreneurial du Sud-Ouest de Madagascar.</p>\n      </div>\n      <div style=\"background:#fff; border-radius:10px; padding:15px; margin-bottom:12px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n        <p style=\"font-size:12px; color:#0D7C6F; font-weight:700; margin-bottom:4px;\">🎯 Mission</p>\n        <p style=\"font-size:10px; color:#333; line-height:1.4;\">Création réelle d'emplois et génération de revenus stables pour la région Atsimo Andrefana.</p>\n      </div>\n      <div style=\"background:#fff; border-radius:10px; padding:15px; margin-bottom:12px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n        <p style=\"font-size:12px; color:#0D7C6F; font-weight:700; margin-bottom:4px;\">🌍 Zone</p>\n        <p style=\"font-size:10px; color:#333; line-height:1.4;\">Districts de Toliara, Bezaha, Tanandava, Miary, Ankililoaka et communes rurales.</p>\n      </div>\n    </div>\n    <div style=\"flex:0.75; background:linear-gradient(135deg, #0A1628, #1A3A5C); border-radius:14px; padding:22px; color:#fff;\">\n      <p style=\"font-size:16px; font-weight:700; margin-bottom:12px; color:#4ECDC4;\">Notre Vision</p>\n      <p style=\"font-size:12px; font-weight:600; margin-bottom:10px;\">Être l'acteur incontournable du développement de l'entrepreneuriat régional.</p>\n      <p style=\"font-size:10px; line-height:1.6; opacity:0.85;\">Stimuler l'économie locale par un accompagnement structuré des initiatives privées et la valorisation des ressources naturelles.</p>\n      <p style=\"font-size:15px; font-weight:700; color:#4ECDC4; margin-top:15px;\">Carso mikarakara soa !</p>\n      <p style=\"font-size:10px; opacity:0.6;\">Carso takes care so!</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"slide\">\n  <h1>Nos Valeurs</h1>\n  <div style=\"display:flex; gap:22px; margin-top:22px;\">\n    <div style=\"flex:1; background:#fff; border-radius:14px; padding:25px 18px; text-align:center; box-shadow:0 6px 25px rgba(0,0,0,0.08); position:relative; overflow:hidden;\">\n      <div style=\"position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg, #0D7C6F, #4ECDC4);\"></div>\n      <p style=\"font-size:40px; margin-bottom:10px;\">💡</p>\n      <p style=\"font-size:16px; font-weight:700; color:#0A1628; margin-bottom:8px;\">Innovation</p>\n      <p style=\"font-size:10px; color:#555; line-height:1.5;\">Créativité et solutions nouvelles pour valoriser les ressources locales.</p>\n    </div>\n    <div style=\"flex:1; background:#fff; border-radius:14px; padding:25px 18px; text-align:center; box-shadow:0 6px 25px rgba(0,0,0,0.08); position:relative; overflow:hidden;\">\n      <div style=\"position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg, #0D7C6F, #4ECDC4);\"></div>\n      <p style=\"font-size:40px; margin-bottom:10px;\">🏆</p>\n      <p style=\"font-size:16px; font-weight:700; color:#0A1628; margin-bottom:8px;\">Professionnalisme</p>\n      <p style=\"font-size:10px; color:#555; line-height:1.5;\">Méthodes rigoureuses et standards de qualité pour chaque porteur de projet.</p>\n    </div>\n    <div style=\"flex:1; background:#fff; border-radius:14px; padding:25px 18px; text-align:center; box-shadow:0 6px 25px rgba(0,0,0,0.08); position:relative; overflow:hidden;\">\n      <div style=\"position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg, #0D7C6F, #4ECDC4);\"></div>\n      <p style=\"font-size:40px; margin-bottom:10px;\">🤝</p>\n      <p style=\"font-size:16px; font-weight:700; color:#0A1628; margin-bottom:8px;\">Satisfaction Client</p>\n      <p style=\"font-size:10px; color:#555; line-height:1.5;\">Accompagnement sur mesure et suivi personnalisé.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"slide\">\n  <h1>Nos Secteurs d'Intervention</h1>\n  <div style=\"display:grid; grid-template-columns:1fr 1fr 1fr; gap:18px; margin-top:22px;\">\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🦆</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Élevage &amp; Aviculture</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Fois gras, magret, canard. Vache laitière PRN. Élevage caprin.</p>\n      </div>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🌿</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Transformation Agroalimentaire</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Farine de manioc, banane, stevia, tomate, chips, nouilles.</p>\n      </div>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🐟</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Aquaculture</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Poisson-canard, tilapia monosex, fermes piscicoles.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"slide\">\n  <h1>Nos Secteurs d'Intervention (suite)</h1>\n  <div style=\"display:grid; grid-template-columns:1fr 1fr 1fr; gap:18px; margin-top:22px;\">\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🌳</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Filières Spécifiques</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Ricin (kinagna), Moringa, fibre de bananier, baobab, sisal.</p>\n      </div>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🌴</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Agriculture &amp; Arboriculture</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Palmiers dattiers, verger, mils, pois du cap, lentilles.</p>\n      </div>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🧴</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Produits Dérivés</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Savon, shampoing, charcuterie, farine de poisson, vinaigre.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"slide\">\n  <h1>Projets Phares</h1>\n  <div style=\"display:grid; grid-template-columns:1fr 1fr 1fr; gap:18px; margin-top:22px;\">\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🏭</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Farine de Manioc</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Unité de fabrication à Mitsinjo Betanimena, Tuléar.</p>\n      </div>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🌱</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Moringa du Sud</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Transformation en produits finis à haute valeur nutritionnelle.</p>\n      </div>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🫒</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Huile de Ricin — Kinagna</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Atelier de production dans la région Atsimo Andrefana.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"slide\">\n  <h1>Projets Phares (suite)</h1>\n  <div style=\"display:grid; grid-template-columns:1fr 1fr 1fr; gap:18px; margin-top:22px;\">\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🌳</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Filière Baobab</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Poudre, huile végétale, savon, shampoing solide.</p>\n      </div>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🥥</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Dattier de Tuléar</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Datte en barquette, vinaigre de datte (Ambohitsabo).</p>\n      </div>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:16px; box-shadow:0 3px 12px rgba(0,0,0,0.07); display:flex; gap:12px; align-items:flex-start;\">\n      <div style=\"font-size:28px; flex-shrink:0; width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #E8F8F5, #D1F2EB); border-radius:8px;\">🧶</div>\n      <div>\n        <p style=\"font-size:12px; font-weight:700; color:#0A1628; margin-bottom:3px;\">Projet Sisal — Telecom</p>\n        <p style=\"font-size:9px; color:#555; line-height:1.4;\">Plantation et production de fibres industrielles.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"slide\">\n  <h1>Notre Approche</h1>\n  <div style=\"display:flex; gap:25px; margin-top:20px;\">\n    <div style=\"flex:1;\">\n      <div style=\"background:#fff; border-radius:10px; padding:15px; margin-bottom:12px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n        <p style=\"font-size:12px; color:#0D7C6F; font-weight:700; margin-bottom:4px;\">🎯 Accompagnement Global</p>\n        <p style=\"font-size:10px; color:#333; line-height:1.4;\">De l'idée initiale jusqu'à la mise en œuvre opérationnelle.</p>\n      </div>\n      <div style=\"background:#fff; border-radius:10px; padding:15px; margin-bottom:12px; box-shadow:0 3px 12px rgba(0,0,0,0.07); border-left:4px solid #0D7C6F;\">\n        <p style=\"font-size:12px; color:#0D7C6F; font-weight:700; margin-bottom:4px;\">📈 Double Objectif</p>\n        <p style=\"font-size:10px; color:#333; line-height:1.4;\">Création d'emplois + Revenus stables — impact mesuré.</p>\n      </div>\n    </div>\n    <div style=\"flex:0.75; background:linear-gradient(135deg, #0A1628, #1A3A5C); border-radius:14px; padding:22px; color:#fff;\">\n      <p style=\"font-size:16px; font-weight:700; margin-bottom:12px; color:#4ECDC4;\">Notre Méthode</p>\n      <p style=\"font-size:11px; line-height:1.7; opacity:0.9;\">1. Identification des ressources locales</p>\n      <p style=\"font-size:11px; line-height:1.7; opacity:0.9;\">2. Accompagnement technique et financier</p>\n      <p style=\"font-size:11px; line-height:1.7; opacity:0.9;\">3. Mise en place de productions</p>\n      <p style=\"font-size:11px; line-height:1.7; opacity:0.9;\">4. Suivi et évaluation de l'impact</p>\n      <p style=\"font-size:11px; line-height:1.7; opacity:0.9;\">5. Élargissement progressif</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"slide\">\n  <h1>Nos Partenaires</h1>\n  <div style=\"display:flex; gap:25px; margin-top:25px; justify-content:center;\">\n    <div style=\"background:#fff; border-radius:10px; padding:20px 30px; box-shadow:0 4px 15px rgba(0,0,0,0.08); text-align:center; min-width:180px;\">\n      <p style=\"font-size:32px; margin-bottom:8px;\">🏛️</p>\n      <p style=\"font-size:14px; font-weight:700; color:#0A1628;\">Projet PIC</p>\n      <p style=\"font-size:10px; color:#777; margin-top:3px;\">Programme MIARY</p>\n    </div>\n    <div style=\"background:#fff; border-radius:10px; padding:20px 30px; box-shadow:0 4px 15px rgba(0,0,0,0.08); text-align:center; min-width:180px;\">\n      <p style=\"font-size:32px; margin-bottom:8px;\">🌍</p>\n      <p style=\"font-size:14px; font-weight:700; color:#0A1628;\">Région Atsimo Andrefana</p>\n      <p style=\"font-size:10px; color:#777; margin-top:3px;\">Collectivité territoriale</p>\n    </di