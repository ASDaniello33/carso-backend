INSERT INTO annonces_pieces (id, annonce_id, nom, chemin, mime, taille, position)
        SELECT gen_random_uuid(), a.id, a.piece_nom, a.piece_chemin, a.piece_mime,
               a.piece_taille, 0
        FROM annonces a
        WHERE a.piece_chemin IS NOT NULL
          AND NOT EXISTS (
