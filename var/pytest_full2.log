UPDATE missions
               SET statut = CASE
                   WHEN statut = 'en_preparation' THEN 'planifie'
                   WHEN statut = 'cloturee' THEN 'cloture'
                   WHEN statut = 'planifiee' THEN CASE
                       WHEN EXISTS (
                           SELECT 1 FROM sessions s WHERE s.mission_id = missions.id
                       ) THEN 'planifie'
                       ELSE 'en_planification'
                   END
                   ELSE statut
               END;

UPDATE sessions
               SET statut = CASE
                   WHEN statut IN ('planifiee', 'confirmee') THEN 'planifie'
                   WHEN statut = 'realisee' THEN 'cloture'
                   WHEN statut = 'annulee' THEN 'annule'
                   ELSE statut
               END;

ALTER TABLE missions ALTER COLUMN statut SET DEFAULT 'en_planification';

ALTER TABLE sessions ALTER COLUMN statut SET DEFAULT 'planifie';

ALTER TABLE sessions ADD CONSTRAINT uq_sessions_mission_id UNIQUE (mission_id);

