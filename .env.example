# CARSO AI — backend : modèle de configuration (copier vers .env et compléter)
#
# Tous les secrets vivent ICI, jamais dans le code, les logs ni les messages
# inter-agents (AGENTS.md §9). Ce fichier modèle ne contient aucune valeur
# réelle : il documente chaque variable et son défaut.

# --- Application ------------------------------------------------------------
ENVIRONMENT=development            # "production" rend SMTP obligatoire pour les emails
DEBUG=true

# --- Origines CORS (CORS_ORIGINS) -------------------------------------------
# Allowlist des origines autorisées à appeler l'API depuis un navigateur,
# séparées par des virgules. Une origine absente : préflight refusé (400) et
# requête annulée par le navigateur (« rien ne se passe » sur les formulaires).
# Défauts : le développement local. Pour tester via tunnel Cloudflare ou pour
# un déploiement, ajouter l'origine PUBLIQUE DU FRONTEND (voir
# docs/api/TUNNEL-DEPLOIEMENT.md).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3950,http://127.0.0.1:3950

# --- Base de données --------------------------------------------------------
DATABASE_URL=postgresql+psycopg://carso:carso@localhost:5432/carso_dev

# --- Authentification (secrets) ---------------------------------------------
# Secret de signature des JWT : ABSENT ⇒ le login refuse explicitement.
AUTH_SECRET=

# Durée de vie du jeton de session, en MINUTES. Défaut : 1 mois (43200).
# À l'expiration, le frontend déconnecte l'utilisateur et le renvoie sur la
# page de connexion (décode le champ `exp` du jeton, plus tout 401 backend).
AUTH_TOKEN_MINUTES=43200

# Compte administrateur créé au démarrage (optionnel).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Envoi d'email (SMTP) — « mot de passe oublié » --------------------------
# SMTP_HOST absent : en développement l'email part sur la console des
# journaux ; en production l'envoi refuse explicitement.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_FROM=no-reply@carso.mg

# Poids total maximal des pièces jointes d'un email (octets). Plusieurs
# documents enregistrés peuvent accompagner un même message ; au-delà, l'envoi
# est refusé avec un message actionnable (jamais tronqué en silence).
EMAIL_PIECES_JOINTES_MAX_OCTETS=10485760

# --- Mot de passe oublié : code à usage unique ------------------------------
MOT_DE_PASSE_OUBLIE_CODE_MINUTES=15       # durée de vie du code (minutes)
MOT_DE_PASSE_OUBLIE_TENTATIVES_MAX=5      # essais par code
MOT_DE_PASSE_OUBLIE_DELAI_SECONDES=60     # délai anti-spam entre deux demandes

# --- Géographie : recherche de lieux et itinéraires --------------------------
# La recherche d'adresse (Photon) ne demande pas de clé ; elle est appelée par
# le backend, jamais par le navigateur.
PHOTON_BASE_URL=https://photon.komoot.io/api
PHOTON_TIMEOUT_S=8

# Itinéraires (OpenRouteService). Sans clé, la route répond explicitement
# « service non configuré » : elle n'invente ni distance ni durée.
# HEIGIT_BASE_URL est surchargeable : api.heigit.org a eu un certificat expiré,
# l'API officielle accepte la même clé et les mêmes chemins.
HEIGIT_API_KEY=
HEIGIT_BASE_URL=https://api.heigit.org/openrouteservice
ITINERAIRES_TIMEOUT_S=15
# Durée de validité du cache d'itinéraires (jours) : une ligne expirée n'est
# jamais servie, le trajet est recalculé.
ITINERAIRES_CACHE_JOURS=30

# Qualité des routes (OpenStreetMap). ORS rend l'identifiant OSM des voies
# traversées ; Overpass fournit leurs tags (smoothness, tracktype, accès).
# Sans accès Overpass, l'itinéraire s'affiche en qualité inconnue — jamais en
# vert par défaut.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# Overpass est un service public saturé (502 « at capacity », 30 s et plus) :
# un délai trop court classerait tout en « inconnu ». Un échec reste silencieux
# pour l'itinéraire (estimation par extras OpenRouteService).
OVERPASS_TIMEOUT_S=45
OSM_TAGS_CACHE_JOURS=30



# --- Météo, imagerie satellite et veille cyclonique -------------------------

# Sources PUBLIQUES, SANS CLÉ. Elles servent à préparer un déplacement : ce sont

# des aides à la décision, jamais une garantie de sécurité (voir

# docs/design/METEO_ET_RISQUES.md). Chaque source se désactive seule.

METEO_ACTIF=true

# Fournisseur de conditions. Interchangeable par configuration : ajouter une

# implémentation dans app/geo/meteo.py, sans toucher à la carte.

METEO_FOURNISSEUR=open-meteo

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

OPEN_METEO_TIMEOUT_S=12

# Durée de validité d'une prévision en cache (secondes).

METEO_CONDITIONS_TTL_S=600

# Plafond d'appels externes par minute, toutes sources météo confondues :

# l'animation satellite demande plusieurs images d'affilée.

METEO_REQUETES_PAR_MINUTE=40



# Imagerie satellite — EUMETSAT EUMETView (MSG Indian Ocean, pas de 15 min).

METEO_SATELLITE_ACTIF=true

EUMETVIEW_WMS_URL=https://view.eumetsat.int/geoserver/wms

# Le rendu d'un GetMap a été mesuré entre 3 et 74 s : une borne courte

# classerait une image en échec alors qu'elle arrive.

EUMETVIEW_TIMEOUT_S=60

# GetCapabilities (282 Ko) sert à connaître le dernier créneau publié : 6 h.

EUMETVIEW_CAPACITES_TTL_S=21600

# Une image d'un créneau passé ne change plus : cache long, taille bornée.

METEO_SATELLITE_TTL_S=3600

METEO_SATELLITE_IMAGES_MAX=40

# 512 px : 22 s de rendu mesuré contre 74 s à 1024 px, ~6 km/pixel sur la région.

METEO_SATELLITE_TAILLE=512



# Fournisseur secondaire — NASA GIBS (réflectance vraie couleur journalière).

GIBS_ACTIF=true

GIBS_WMS_URL=https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi

GIBS_TIMEOUT_S=25



# Veille cyclonique — GDACS (Commission européenne / JRC). Service parfois lent
# (4 à 11 s en régime normal, coupures de 60 s et plus). La borne est
# plus courte que ce pire cas : la météo du trajet attend la veille, et
# une requête ne doit pas expirer parce que GDACS ne répond pas.
# L'échec est affiché, jamais simulé.


METEO_CYCLONES_ACTIF=true

GDACS_API_URL=https://www.gdacs.org/gdacsapi/api

GDACS_TIMEOUT_S=20

METEO_CYCLONES_TTL_S=900

METEO_CYCLONES_JOURS=7



# Emprise des images satellite : Madagascar et l'océan Indien sud-ouest.

METEO_REGION_SUD=-30

METEO_REGION_OUEST=30

METEO_REGION_NORD=2

METEO_REGION_EST=60

